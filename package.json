{
  "name": "vueless-quickstart",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 4310",
    "build": "vite build",
    "preview": "vite preview --host --port 4310",
    "lint": "eslint --no-fix src/ .storybook/ .vueless/",
    "lint:fix": "eslint --fix src/ .storybook/ .vueless/",
    "lint:ci": "eslint --no-fix --max-warnings=0",
    "test": "vitest",
    "test:ci": "vitest --run",
    "sb:dev": "storybook dev -p 6006 --no-open",
    "sb:dev:docs": "storybook dev -p 6006 --docs --no-open",
    "sb:build": "storybook build --docs",
    "sb:preview": "vite preview --host --outDir=storybook-static"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.1.2",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.15.2",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "qs": "^6.15.1",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.5.0",
    "vueless": "^1.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.9",
    "@vueless/storybook": "^1.5.6",
    "eslint": "^10.2.1",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
